{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open1650.org/schemas/psalm.schema.json",
  "title": "Open 1650 Psalm Record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "psalm_number",
    "version",
    "meter",
    "source",
    "rights",
    "stanzas"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^ps1650\\.psalm-[0-9]{3}\\.(primary|alternate)$"
    },
    "psalm_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 150
    },
    "version": {
      "enum": ["primary", "alternate"]
    },
    "meter": {
      "type": "object",
      "required": ["pattern", "name"],
      "properties": {
        "pattern": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "stanzas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "number", "lines"],
        "properties": {
          "id": { "type": "string" },
          "number": { "type": "integer", "minimum": 1 },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "number", "text"],
              "properties": {
                "id": { "type": "string" },
                "number": { "type": "integer", "minimum": 1 },
                "syllable_count": { "type": "integer", "minimum": 1 },
                "text": {
                  "type": "object",
                  "required": ["diplomatic", "normalized", "reading"],
                  "properties": {
                    "diplomatic": { "type": "string", "minLength": 1 },
                    "normalized": { "type": "string", "minLength": 1 },
                    "reading": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
